# Every variable here must also exist as an EAS environment variable, otherwise
# remote builds ship with it undefined. app.config.ts fails the build if one is
# missing: eas env:create --name <NAME> --environment production --visibility plaintext
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Declare exactly once. Restrict the key by package + SHA-1 (Android), bundle id
# (iOS) and HTTP referrer (web) in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google OAuth client of type "Web application" (token audience for Supabase).
# A "Desktop app" client is NOT interchangeable: Android Credential Manager
# rejects it and reports the failure as a plain user cancellation.
# Android selects its own OAuth client automatically from package + signing SHA-1.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
# Google OAuth client of type "iOS" for com.casaseg.mobile. Required on iOS:
# app.config.ts derives the reversed-client-id URL scheme from it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
