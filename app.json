{
  "expo": {
    "name": "casaseg",
    "slug": "casaseg",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "casaseg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/splash-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/splash-icon.png",
      "manifest": {
        "display": "standalone",
        "background_color": "#F3F9FD",
        "theme_color": "#1D66A3",
        "scope": "/",
        "start_url": "/",
        "description": "CasaSeg - Encuentra tu hogar ideal",
        "lang": "es",
        "orientation": "any",
        "categories": ["real-estate", "lifestyle"],
        "icons": [
          {
            "src": "/icons/pwa-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "/icons/pwa-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F9FD",
          "image": "./assets/images/splash-brand-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "imageWidth": 176
          },
          "dark": {
            "backgroundColor": "#0B131B",
            "image": "./assets/images/splash-brand-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "fr", "en"],
            "android": ["es", "fr", "en"]
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CasaSeg necesita acceso a tus fotos para publicar imágenes de una propiedad."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CasaSeg usa tu ubicación solo cuando lo solicitas para mostrar viviendas cercanas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
