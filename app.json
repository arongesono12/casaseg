{
  "expo": {
    "name": "casaseg",
    "slug": "casaseg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casaseg",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "manifest": {
        "display": "standalone",
        "background_color": "#2563EB",
        "theme_color": "#2563EB",
        "scope": "/",
        "start_url": "/",
        "description": "CasaSeg - Encuentra tu hogar ideal",
        "lang": "es",
        "orientation": "portrait-primary",
        "categories": ["real-estate", "lifestyle"],
        "icons": [
          {
            "src": "/icons/pwa-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
          },
          {
            "src": "/icons/pwa-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
          }
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0A0A0A",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.casaseg.mobile",
          "enableGooglePay": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CasaSeg necesita acceso a tus fotos para publicar imágenes de una propiedad."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CasaSeg usa tu ubicación solo cuando lo solicitas para mostrar viviendas cercanas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
